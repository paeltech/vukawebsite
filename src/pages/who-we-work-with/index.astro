---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import AudienceHubCards from '@/components/sections/AudienceHubCards.astro';
import ContentSection from '@/components/sections/ContentSection.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import PageCTA from '@/components/sections/PageCTA.astro';
import ContextNav from '@/components/ui/ContextNav.astro';
import { whoWeWorkWith } from '@/data/copy/audiences';
---

<BaseLayout title="Who we work with">
  <Section>
    <PageHeader {...whoWeWorkWith.header} headlineSize="hero">
      <ContextNav
        links={[
          { label: 'Audiences on home', href: '/#audiences' },
          { label: 'How we build', href: '/#pathways' },
        ]}
      />
    </PageHeader>
  </Section>

  <Section variant="sand">
    <ContentSection label={whoWeWorkWith.overview.label} icon="situation">
      <p class="max-w-3xl text-lg leading-relaxed whitespace-pre-line text-vuka-black">
        {whoWeWorkWith.overview.body}
      </p>
    </ContentSection>
  </Section>

  <Section>
    <AudienceHubCards cards={whoWeWorkWith.cards} />
  </Section>

  <Section variant="sand">
    <PageCTA
      cta={{
        headline: whoWeWorkWith.bottomNote,
        label: whoWeWorkWith.bottomCta.label,
        href: whoWeWorkWith.bottomCta.href,
      }}
    />
  </Section>
</BaseLayout>
