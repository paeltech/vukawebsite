---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import HubLinkList from '@/components/sections/HubLinkList.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import PageCTA from '@/components/sections/PageCTA.astro';
import SectionPromo from '@/components/sections/SectionPromo.astro';
import { homeAudiences } from '@/data/copy/home';
import { whoWeWorkWith } from '@/data/copy/audiences';

const audienceLinks = homeAudiences.cards.map((card) => ({
  label: card.tag,
  description: card.headline,
  href: card.cta.href,
}));
---

<BaseLayout title="Who we work with">
  <Section>
    <PageHeader {...whoWeWorkWith.header} headlineSize="hero" />
  </Section>

  <Section variant="sand">
    <div class="grid grid-cols-1 gap-vuka-4xl lg:grid-cols-2 lg:items-start">
      <SectionPromo {...whoWeWorkWith.hubPromo} />
      <HubLinkList links={audienceLinks} />
    </div>
  </Section>

  <Section>
    <PageCTA
      cta={{
        headline: whoWeWorkWith.bottomNote,
        label: whoWeWorkWith.bottomCta.label,
        href: whoWeWorkWith.bottomCta.href,
      }}
    />
  </Section>
</BaseLayout>
