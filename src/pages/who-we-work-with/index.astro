---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ReferenceHero from '@/components/reference/ReferenceHero.astro';
import Partners from '@/components/reference/Partners.astro';
import Closing from '@/components/reference/Closing.astro';
import { referenceCopy } from '@/data/copy/reference';
const copy = referenceCopy.pages.partners;
---
<BaseLayout title="Who we work with" description={copy.header.subcopy} class="reference-page">
  <Section class="reference-page-intro"><ReferenceHero {...copy.header} /></Section>
  <Section class="reference-section"><Partners /></Section>
  <Section variant="sand" class="reference-section"><p class="reference-label mb-6">{copy.technology.label}</p><h2 class="reference-h2">{copy.technology.headline}</h2><article class="reference-simple-row mt-12"><span class="reference-label" aria-hidden="true">01</span><h3>{copy.technology.title}</h3><div><p>{copy.technology.body}</p><a href="/partners" class="editorial-link">{copy.technology.cta}</a></div></article></Section>
  <Closing />
</BaseLayout>
