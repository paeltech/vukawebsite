---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import VentureFeature from '@/components/reference/VentureFeature.astro';
import Closing from '@/components/reference/Closing.astro';
import { isPortfolioEnabled } from '@/config/site';
if (!isPortfolioEnabled()) return Astro.redirect('/');
---
<BaseLayout title="Portfolio" class="reference-page">
  <Section class="reference-page-intro"><VentureFeature portfolioPage /></Section>
  <Closing />
</BaseLayout>
