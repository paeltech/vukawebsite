---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ReferenceHero from '@/components/reference/ReferenceHero.astro';
import StudioForm from '@/components/reference/StudioForm.astro';
import { referenceCopy } from '@/data/copy/reference';
const copy = referenceCopy.pages.talent;
---
<BaseLayout title="Join the studio" description={copy.subcopy} class="reference-page reference-contact-page">
  <Section class="reference-form-intro"><div class="reference-form-layout"><div class="reference-form-copy"><ReferenceHero eyebrow={copy.eyebrow} headline={copy.headline} subcopy={copy.subcopy} /><p class="mt-8 whitespace-pre-line">{copy.note}</p><p class="mt-8">Looking to invest instead?<br /><a class="editorial-link" href="/investors">Explore studio investment ↗</a></p></div><div><h2 class="mb-8 text-[26px] leading-[34px]">{copy.formTitle}</h2><StudioForm kind="talent" /></div></div></Section>
</BaseLayout>
