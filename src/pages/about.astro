---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ReferenceHero from '@/components/reference/ReferenceHero.astro';
import StudioFeature from '@/components/reference/StudioFeature.astro';
import Closing from '@/components/reference/Closing.astro';
import { referenceCopy } from '@/data/copy/reference';
import { isAboutEnabled } from '@/config/site';
if (!isAboutEnabled()) return Astro.redirect('/');
const copy = referenceCopy.pages.studio;
---
<BaseLayout title="Studio" description={copy.header.subcopy} class="reference-page">
  <Section class="reference-page-intro"><ReferenceHero {...copy.header} /></Section>
  <Section class="reference-section"><StudioFeature studioPage /></Section>
  <Section variant="sand" class="reference-section"><div class="reference-editorial"><p class="reference-label">{copy.founder.label}</p><div><h2 class="reference-h2">{copy.founder.headline}</h2><p class="reference-term-body">{copy.founder.body}</p></div></div></Section>
  <Section class="reference-section"><p class="reference-label mb-6">{copy.principles.label}</p><h2 class="reference-h2">{copy.principles.headline}</h2><div class="reference-rows">{copy.principles.rows.map((row, i) => <article class="reference-simple-row"><span class="reference-label" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{row.title}</h3><div><p>{row.body}</p></div></article>)}</div></Section>
  <Closing />
</BaseLayout>
