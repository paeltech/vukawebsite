---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ReferenceHero from '@/components/reference/ReferenceHero.astro';
import StudioForm from '@/components/reference/StudioForm.astro';
import { referenceCopy } from '@/data/copy/reference';
import { siteConfig } from '@/config/site';
const copy = referenceCopy.pages.contact;
---
<BaseLayout title="Work with us" description={copy.subcopy} class="reference-page reference-contact-page">
  <Section class="reference-form-intro"><div class="reference-form-layout"><div class="reference-form-copy"><ReferenceHero eyebrow={copy.eyebrow} headline={copy.headline} subcopy={copy.subcopy} /><p class="mt-8">Prefer email?<br /><a class="editorial-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email} ↗</a></p></div><div><h2 class="mb-8 text-[26px] leading-[34px]">{copy.formTitle}</h2><StudioForm /></div></div></Section>
</BaseLayout>
