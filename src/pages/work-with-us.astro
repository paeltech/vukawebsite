---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import HubLinkList from '@/components/sections/HubLinkList.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { workWithUs } from '@/data/copy/work-with-us';

const preselectedType = Astro.url.searchParams.get('type') ?? '';
---

<BaseLayout title="Work with us">
  <Section>
    <PageHeader {...workWithUs.header} headlineSize="hero" />
  </Section>

  <Section variant="sand">
    <SectionLabel text="Where to start" class="mb-vuka-2xl" />
    <p class="vuka-reveal mb-vuka-3xl max-w-xl text-lg text-vuka-black">
      Not ready for the form? Open an audience route or return to the overview on the home page.
    </p>
    <HubLinkList links={workWithUs.startingPoints} class="max-w-2xl" />
  </Section>

  <Section>
    <SectionLabel text={workWithUs.formHeader.headline} class="mb-4" />
    <p class="vuka-reveal mb-vuka-3xl max-w-xl text-lg text-vuka-black whitespace-pre-line">
      {workWithUs.formHeader.subcopy}
    </p>
    <div class="max-w-2xl">
      <ContactForm preselectedType={preselectedType} />
    </div>
    <div class="vuka-reveal mt-vuka-3xl">
      <p class="mb-2 font-light text-baobab">{workWithUs.directContact.label}</p>
      <a href={`mailto:${workWithUs.directContact.email}`} class="font-bold text-xl text-ember hover:text-ember-hover">
        {workWithUs.directContact.email}
      </a>
    </div>
  </Section>
</BaseLayout>
