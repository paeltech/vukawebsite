---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ReferenceHero from '@/components/reference/ReferenceHero.astro';
import Partners from '@/components/reference/Partners.astro';
import Services from '@/components/reference/Services.astro';
import BuildProcess from '@/components/reference/BuildProcess.astro';
import VentureFeature from '@/components/reference/VentureFeature.astro';
import StudioFeature from '@/components/reference/StudioFeature.astro';
import Closing from '@/components/reference/Closing.astro';
import { referenceCopy } from '@/data/copy/reference';
import { isPortfolioEnabled } from '@/config/site';
const copy = referenceCopy.home;
---
<BaseLayout class="reference-page">
  <Section class="reference-page-intro reference-home-intro overflow-hidden">
    <ReferenceHero {...copy.hero} home cta={copy.hero.primary} href="/work-with-us" secondary={copy.hero.secondary} />
  </Section>
  <Section id="why" class="reference-section">
    <div class="reference-proposition">
      <div><p class="reference-label">{copy.why.label}</p><h2 class="reference-h2">{copy.why.headline}</h2></div>
      <div class="reference-reading"><p class="reference-lead">{copy.why.lead}</p><p>{copy.why.body}</p><a href="/what-we-do" class="editorial-link">{copy.why.cta}</a></div>
    </div>
  </Section>
  <Section id="audiences" variant="sand" class="reference-section"><Partners /></Section>
  <Section id="services" class="reference-section"><span id="pathways" aria-hidden="true"></span><Services home /></Section>
  <Section id="process" variant="dark" class="reference-section"><BuildProcess /></Section>
  <Section id="difference" class="reference-section">
    <div class="reference-difference">
      <div class="reference-difference-heading"><p class="reference-label">{copy.difference.label}</p><h2 class="reference-h2">{copy.difference.headline}</h2></div>
      <div class="reference-comparisons">{copy.difference.comparisons.map(item => <div><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>
      <div class="reference-difference-bottom"><p class="reference-lead">{copy.difference.lead}</p><div class="reference-difference-body"><p>{copy.difference.body}</p><a href="/about" class="editorial-link">{copy.difference.cta}</a></div></div>
    </div>
  </Section>
  {isPortfolioEnabled() && <Section id="portfolio" variant="sand" class="reference-section"><VentureFeature /></Section>}
  <Section id="studio" class="reference-section"><span id="join-team" aria-hidden="true"></span><StudioFeature /></Section>
  <Closing />
</BaseLayout>
