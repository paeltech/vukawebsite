---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import EmptyState from '@/components/sections/EmptyState.astro';
import FilterBar from '@/components/sections/FilterBar.astro';
import JournalArticleRow from '@/components/sections/JournalArticleRow.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import ContextNav from '@/components/ui/ContextNav.astro';
import { journalPage } from '@/data/copy/thesis';
import { journalTags } from '@/lib/tags';
import { getJournalArticles } from '@/lib/articles';

const articles = await getJournalArticles();
const latestSlug = articles[0]?.slug;
---

<BaseLayout title="Studio journal" description={journalPage.header.subcopy}>
  <Section>
    <PageHeader {...journalPage.header} headlineSize="hero">
      <ContextNav links={[journalPage.thesisLink]} class="mt-vuka-2xl" />
    </PageHeader>

    {
      articles.length === 0 ? (
        <div class="mt-vuka-4xl">
          <EmptyState message={journalPage.emptyState} />
        </div>
      ) : (
        <div class="mt-vuka-4xl">
          <FilterBar
            tags={journalTags}
            targetId="journal-grid"
            emptyMessage={journalPage.filterEmpty}
          />

          <div id="journal-grid" class="mt-vuka-3xl flex flex-col gap-4">
            {
              articles.map((article) => (
                <div data-tags={['All', ...article.siteTags].join('|')}>
                  <JournalArticleRow
                    article={article}
                    basePath="/studio-journal"
                    latest={article.slug === latestSlug}
                  />
                </div>
              ))
            }
          </div>
        </div>
      )
    }
  </Section>
</BaseLayout>
