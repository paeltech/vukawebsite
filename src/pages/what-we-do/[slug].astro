---
import EngagementPage from '@/components/reference/EngagementPage.astro';
import { pathways, type PathwaySlug } from '@/data/copy/pathways';
import { referenceCopy } from '@/data/copy/reference';
export function getStaticPaths() { return (Object.keys(pathways) as PathwaySlug[]).map(slug => ({ params: { slug } })); }
const { slug } = Astro.params as { slug: PathwaySlug };
const page = pathways[slug];
if (!page) return Astro.redirect('/what-we-do');
const types = { 'studio-origination': 'origination', 'founder-in-residence': 'founder', 'corporate-spinout': 'corporate', 'government-innovation': 'government' };
const related = { 'studio-origination': '/our-thesis', 'founder-in-residence': '/what-we-do/studio-origination', 'corporate-spinout': '/corporates', 'government-innovation': '/government' };
---
<EngagementPage copy={referenceCopy.pathways[slug]} enquiry={types[slug]} faqs={page.faqs} engagementBody={page.commercialTerms} relatedHref={related[slug]} />
