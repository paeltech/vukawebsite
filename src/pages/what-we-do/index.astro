---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ReferenceHero from '@/components/reference/ReferenceHero.astro';
import Services from '@/components/reference/Services.astro';
import BuildProcess from '@/components/reference/BuildProcess.astro';
import Closing from '@/components/reference/Closing.astro';
import { referenceCopy } from '@/data/copy/reference';
const copy = referenceCopy.pages.services;
const routes = ['studio-origination', 'founder-in-residence', 'corporate-spinout', 'government-innovation'];
---
<BaseLayout title="What we do" description={copy.header.subcopy} class="reference-page">
  <Section class="reference-page-intro"><ReferenceHero {...copy.header} /></Section>
  <Section variant="sand" class="reference-section"><Services /></Section>
  <Section id="process" variant="dark" class="reference-section"><BuildProcess /></Section>
  <Section id="pathways" class="reference-section"><p class="reference-label mb-6">{copy.pathways.label}</p><h2 class="reference-h2">{copy.pathways.headline}</h2><div class="reference-rows">{copy.pathways.rows.map((row, i) => <article class="reference-simple-row"><span class="reference-label" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{row.title}</h3><div><p>{row.body}</p><a href={`/what-we-do/${routes[i]}`} class="editorial-link">{row.cta}</a></div></article>)}</div></Section>
  <Closing />
</BaseLayout>
