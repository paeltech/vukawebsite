---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ContentSection from '@/components/sections/ContentSection.astro';
import HomePathways from '@/components/sections/HomePathways.astro';
import PageCTA from '@/components/sections/PageCTA.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import StudioCapabilities from '@/components/sections/StudioCapabilities.astro';
import { homePathways } from '@/data/copy/home';
import { whatWeDo } from '@/data/copy/pathways';
---

<BaseLayout title="What we do">
  <Section>
    <PageHeader eyebrow={whatWeDo.eyebrow} headline={whatWeDo.headline} subcopy={whatWeDo.subcopy} headlineSize="hero" />
  </Section>

  <Section variant="sand">
    <HomePathways {...homePathways} />
  </Section>

  <Section variant="dark">
    <StudioCapabilities summary={whatWeDo.summary} services={whatWeDo.services} />
  </Section>

  <Section>
    <ContentSection label={whatWeDo.process.label} icon="process">
      <p class="mb-vuka-3xl max-w-2xl text-lg leading-relaxed text-vuka-black">{whatWeDo.process.intro}</p>
      <ProcessSteps steps={whatWeDo.process.steps} />
    </ContentSection>
  </Section>

  <Section>
    <PageCTA cta={whatWeDo.closingCta} />
  </Section>
</BaseLayout>
