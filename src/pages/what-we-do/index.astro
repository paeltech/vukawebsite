---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ContentSection from '@/components/sections/ContentSection.astro';
import PageCTA from '@/components/sections/PageCTA.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import PathwayCardFull from '@/components/sections/PathwayCardFull.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { whatWeDo, pathways } from '@/data/copy/pathways';

const pathwayList = Object.values(pathways);
---

<BaseLayout title="What we do">
  <Section>
    <PageHeader eyebrow={whatWeDo.eyebrow} headline={whatWeDo.headline} subcopy={whatWeDo.subcopy} headlineSize="hero" />
  </Section>

  <Section>
    <ContentSection label="The studio model" icon="layers">
      <p class="max-w-3xl text-xl leading-relaxed whitespace-pre-line">{whatWeDo.modelDistinction}</p>
    </ContentSection>
  </Section>

  <Section variant="dark">
    <SectionLabel text="Four pathways" inverted class="mb-vuka-3xl" />
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {pathwayList.map((pathway, index) => (
        <PathwayCardFull
          pathway={pathway}
          variant="dark"
          icon={(['pathway-origination', 'pathway-founder', 'pathway-spinout', 'pathway-gov'] as const)[index]}
        />
      ))}
    </div>
  </Section>

  <Section>
    <ContentSection label={whatWeDo.sectorStripLabel} icon="sector-fintech">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {whatWeDo.sectors.map((sector) => (
          <div class="vuka-card flex items-center p-4">
            <span class="text-base font-bold text-vuka-black">{sector}</span>
          </div>
        ))}
      </div>
    </ContentSection>
  </Section>

  <Section>
    <PageCTA
      cta={{
        headline: whatWeDo.bottomCta,
        label: 'Start the conversation →',
        href: '/work-with-us',
      }}
      variant="dark"
    />
  </Section>
</BaseLayout>
