---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ContentSection from '@/components/sections/ContentSection.astro';
import HubLinkList from '@/components/sections/HubLinkList.astro';
import PageCTA from '@/components/sections/PageCTA.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import SectionPromo from '@/components/sections/SectionPromo.astro';
import { homePathways } from '@/data/copy/home';
import { whatWeDo } from '@/data/copy/pathways';

const pathwayLinks = homePathways.cards.map((card) => ({
  label: card.title,
  description: card.body,
  href: card.cta.href,
}));
---

<BaseLayout title="What we do">
  <Section>
    <PageHeader eyebrow={whatWeDo.eyebrow} headline={whatWeDo.headline} subcopy={whatWeDo.subcopy} headlineSize="hero" />
  </Section>

  <Section variant="dark">
    <ContentSection label="The studio model" icon="layers" inverted>
      <p class="max-w-3xl text-xl leading-relaxed text-sand whitespace-pre-line">{whatWeDo.modelDistinction}</p>
    </ContentSection>
  </Section>

  <Section variant="sand">
    <div class="grid grid-cols-1 gap-vuka-4xl lg:grid-cols-2 lg:items-start">
      <SectionPromo {...whatWeDo.hubPromo} />
      <HubLinkList links={pathwayLinks} />
    </div>
  </Section>

  <Section>
    <HubLinkList
      links={[
        {
          label: whatWeDo.thesisLink.label,
          description: whatWeDo.thesisLink.description,
          href: whatWeDo.thesisLink.href,
        },
      ]}
      class="max-w-2xl"
    />
  </Section>

  <Section>
    <PageCTA
      cta={{
        headline: whatWeDo.bottomCta,
        label: 'Start the conversation →',
        href: '/work-with-us',
      }}
    />
  </Section>
</BaseLayout>
