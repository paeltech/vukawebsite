---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import EmptyState from '@/components/sections/EmptyState.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import ThesisEssayCard from '@/components/sections/ThesisEssayCard.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { thesisPage } from '@/data/copy/thesis';
import { getThesisArticles } from '@/lib/articles';

const articles = await getThesisArticles();
---

<BaseLayout title="Our thesis" description={thesisPage.summary}>
  <Section>
    <PageHeader {...thesisPage.header} headlineSize="hero" />

    <p class="vuka-reveal mt-vuka-4xl max-w-3xl text-xl leading-relaxed text-vuka-black">
      {thesisPage.summary}
    </p>

    {
      articles.length > 0 ? (
        <div class="mt-vuka-4xl">
          <SectionLabel text={thesisPage.essaysLabel} class="mb-vuka-3xl" />
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {
              articles.map((article) => (
                <ThesisEssayCard article={article} basePath="/our-thesis" />
              ))
            }
          </div>
        </div>
      ) : (
        <div class="mt-vuka-4xl">
          <EmptyState message={thesisPage.emptyState} />
        </div>
      )
    }
  </Section>
</BaseLayout>
