---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import ContentSection from '@/components/sections/ContentSection.astro';
import FAQ from '@/components/sections/FAQ.astro';
import PageCTA from '@/components/sections/PageCTA.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import RelatedPortfolio from '@/components/sections/RelatedPortfolio.astro';
import TwoColumn from '@/components/sections/TwoColumn.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { audiences, audienceSlugs, type AudienceSlug } from '@/data/copy/audiences';
import { getPortfolioForAudience } from '@/lib/portfolio';

export function getStaticPaths() {
  return audienceSlugs.map((slug) => ({ params: { audience: slug } }));
}

const { audience } = Astro.params;
const page = audiences[audience as AudienceSlug];

if (!page) {
  return Astro.redirect('/who-we-work-with');
}

const relatedVentures = await getPortfolioForAudience(page.slug);

const typeMap: Record<AudienceSlug, string> = {
  founders: 'founder',
  corporates: 'corporate',
  government: 'government',
  investors: 'investor',
  partners: 'partner',
};
---

<BaseLayout title={page.eyebrow}>
  <Section>
    <PageHeader
      eyebrow={page.eyebrow}
      headline={page.headline}
      subcopy={page.subcopy}
      headlineSize="hero"
    />
  </Section>

  <Section variant="dark">
    <ContentSection label="The problem we solve" icon="situation" inverted>
      <p class="max-w-3xl text-xl leading-relaxed whitespace-pre-line text-sand">{page.problem}</p>
    </ContentSection>
  </Section>

  <Section>
    <ContentSection label="How we work together" icon="process">
      <ProcessSteps steps={page.steps} />
    </ContentSection>
  </Section>

  <Section variant="dark">
    <ContentSection label="What each side brings" icon="layers" inverted>
      <TwoColumn youBring={page.youBring} weBring={page.weBring} />
    </ContentSection>
  </Section>

  <Section>
    <ContentSection label="Engagement model" icon="investor">
      <p class="max-w-3xl text-xl leading-relaxed whitespace-pre-line">{page.engagement}</p>
      {
        page.pathways.length > 0 && (
          <div class="mt-vuka-3xl flex flex-col gap-3 border-t border-sand pt-vuka-3xl">
            <p class="font-light text-[11px] uppercase tracking-category text-baobab">Related pathways</p>
            <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              {page.pathways.map((pathway) => (
                <Button href={pathway.href} variant="secondary" class="justify-between sm:w-auto">
                  {pathway.label}
                  <Icon name="arrow-right" size={16} />
                </Button>
              ))}
            </div>
          </div>
        )
      }
    </ContentSection>
  </Section>

  <Section variant="sand">
    <ContentSection label="Why Vuka" icon="proof">
      <p class="max-w-3xl text-xl leading-relaxed whitespace-pre-line">{page.proof}</p>
    </ContentSection>
  </Section>

  {
    relatedVentures.length > 0 && (
      <Section>
        <RelatedPortfolio entries={relatedVentures} intro={page.relatedWorkIntro} />
      </Section>
    )
  }

  <Section variant="dark">
    <ContentSection label="Common questions" icon="quote" inverted>
      <FAQ items={page.faqs} />
    </ContentSection>
  </Section>

  <Section>
    <PageCTA
      cta={{
        ...page.cta,
        href: `/work-with-us?type=${typeMap[page.slug]}`,
      }}
    />
  </Section>
</BaseLayout>
