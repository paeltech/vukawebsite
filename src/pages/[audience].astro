---
import EngagementPage from '@/components/reference/EngagementPage.astro';
import { audiences, audienceSlugs, type AudienceSlug } from '@/data/copy/audiences';
import { referenceCopy } from '@/data/copy/reference';
export function getStaticPaths() { return audienceSlugs.map(slug => ({ params: { audience: slug } })); }
const { audience } = Astro.params;
const slug = audience as AudienceSlug;
const page = audiences[slug];
if (!page) return Astro.redirect('/who-we-work-with');
const types = { founders: 'founder', corporates: 'corporate', government: 'government', investors: 'investor', partners: 'partner' };
const related = { founders: '/what-we-do/founder-in-residence', corporates: '/what-we-do/corporate-spinout', government: '/what-we-do/government-innovation', investors: '/our-thesis', partners: '/our-thesis' };
---
<EngagementPage copy={referenceCopy.audiences[slug]} enquiry={types[slug]} faqs={page.faqs} engagementBody={page.engagement} relatedHref={related[slug]} />
