---
import Container from '@/components/layout/Container.astro';
import Wordmark from '@/components/ui/Wordmark.astro';
import { siteConfig, isAboutEnabled, isPortfolioEnabled } from '@/config/site';
const studioLinks = [
  { label: 'How we build', href: '/what-we-do' },
  ...(isPortfolioEnabled() ? [{ label: 'Portfolio', href: '/portfolio' }] : []),
  ...(isAboutEnabled() ? [{ label: 'The studio', href: '/about' }] : []),
  { label: 'Our thesis', href: '/our-thesis' },
  { label: 'Studio journal', href: '/studio-journal' },
];
const buildLinks = [
  { label: 'Who we work with', href: '/who-we-work-with' },
  { label: 'Start a conversation', href: '/work-with-us' },
  { label: 'Join the studio', href: '/join-our-team' },
];
---
<footer class="site-footer reference-footer">
  <Container>
    <div class="reference-footer-grid">
      <div class="footer-brand"><Wordmark variant="parchment" /><p>AI-native venture studio.<br />Dar es Salaam, East Africa.</p></div>
      <nav aria-label="Studio"><h2>Studio</h2>{studioLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav>
      <nav aria-label="Build with us"><h2>Build with us</h2>{buildLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav>
      <div class="footer-contact"><h2>Get in touch</h2><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div>
    </div>
    <p class="footer-copyright">© {new Date().getUTCFullYear()} Vuka Ventures</p>
  </Container>
</footer>
<style>
  .reference-footer { padding: 0 0 32px; background: var(--color-vuka-black); color: var(--color-parchment); }
  .reference-footer-grid { display: grid; grid-template-columns: 1.3fr .8fr 1fr 1.1fr; gap: 40px; padding-top: 48px; border-top: 1px solid #d4c4a833; }
  .footer-brand p { margin-top: 20px; color: var(--color-sand); font-size: 14px; line-height: 1.8; }
  nav, .footer-contact { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  h2 { margin: 0 0 6px; color: var(--color-sand); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  a { font-size: 14px; line-height: 1.6; text-underline-offset: 4px; }
  a:hover { color: var(--color-sand); text-decoration: underline; }
  .footer-contact a { overflow-wrap: anywhere; }
  .footer-copyright { margin-top: 48px; color: var(--color-sand); font-size: 12px; line-height: 20px; }
  @media (max-width: 1023px) { .reference-footer-grid { grid-template-columns: 1fr 1fr; gap: 36px; } }
  @media (max-width: 479px) { .reference-footer-grid { grid-template-columns: 1fr 1fr; gap: 32px 24px; } .footer-brand, .footer-contact { grid-column: 1 / -1; } }
</style>
