---
import Button from '@/components/ui/Button.astro';
import NavDropdown from '@/components/layout/NavDropdown.astro';
import MobileNav from '@/components/layout/MobileNav.astro';
import Wordmark from '@/components/ui/Wordmark.astro';
import { navLinks, primaryCta } from '@/config/site';
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrentPage = (href: string) => !href.includes('#') && (currentPath === href || currentPath.startsWith(`${href}/`));

interface ChildLink {
  label: string;
  href: string;
}

type NavEntry =
  | { label: string; href: string }
  | { label: string; href: string; children: readonly ChildLink[] };

function hasChildren(link: NavEntry): link is NavEntry & { children: readonly ChildLink[] } {
  return 'children' in link && Array.isArray(link.children);
}
---

<header
  id="site-header"
  class="site-header sticky top-0 z-50 border-b border-transparent bg-parchment pt-0 transition-[background-color,border-color,backdrop-filter] duration-200 md:pt-0"
  data-scrolled="false"
>
  <div class="mx-auto flex h-[72px] md:h-[88px] max-w-[1440px] items-center gap-6 px-6 md:px-10 xl:px-20">
    <Wordmark variant="default" class="shrink-0" />

    <nav class="hidden flex-1 items-center justify-end gap-4 xl:gap-6 lg:flex" aria-label="Primary">
      {
        navLinks.map((link) =>
          hasChildren(link) ? (
            <NavDropdown label={link.label} href={link.href} items={link.children} />
          ) : (
            <a href={link.href} aria-current={isCurrentPage(link.href) ? 'page' : undefined} class="nav-link font-normal text-base transition-colors">
              {link.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <div class="hidden lg:block">
        <Button href={primaryCta.href} size="lg">
          {primaryCta.label} <span aria-hidden="true">↗</span>
        </Button>
      </div>

      <button
        type="button"
        id="mobile-nav-open"
        class="site-header-menu flex h-11 w-11 items-center justify-center rounded-sm transition-colors lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileNav />

<script>
  import '@/scripts/header-scroll';
</script>

<style is:global>
  .site-header .nav-link {
    color: var(--color-vuka-black);
  }

  .site-header .nav-link:hover, .site-header .nav-link[aria-current="page"] {
    color: var(--color-ember-hover);
  }

  .site-header .site-header-menu {
    color: var(--color-vuka-black);
  }

  .site-header .site-header-menu:hover {
    background: color-mix(in srgb, var(--color-sand) 50%, transparent);
  }

  .site-header[data-scrolled='true'] {
    border-color: color-mix(in srgb, var(--color-baobab) 30%, transparent);
    background: var(--color-parchment);
    backdrop-filter: blur(8px);
  }
</style>
