---
import { cn } from '@/lib/cn';

interface Props {
  text: string;
  class?: string;
  inverted?: boolean;
}

const { text, class: className = '', inverted = false } = Astro.props;
---

<h2
  class={cn(
    'font-bold text-2xl md:text-3xl',
    inverted ? 'text-parchment' : 'text-vuka-black',
    className,
  )}
>
  {text}
</h2>
