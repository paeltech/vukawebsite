---
import { cn } from '@/lib/cn';

export interface ContextNavLink {
  label: string;
  href: string;
}

interface Props {
  links: readonly ContextNavLink[];
  inverted?: boolean;
  class?: string;
}

const { links, inverted = false, class: className = '' } = Astro.props;

const separatorClass = inverted ? 'text-sand/50' : 'text-baobab/60';
const linkClass = inverted
  ? 'font-bold text-ember hover:text-ember-hover'
  : 'font-bold text-ember hover:text-ember-hover';
---

<nav aria-label="Page context" class={cn('vuka-reveal mt-vuka-xl flex flex-wrap items-center gap-x-3 gap-y-1 text-sm', className)}>
  {
    links.map((link, index) => (
      <>
        {index > 0 && <span class={separatorClass} aria-hidden="true">·</span>}
        <a href={link.href} class={linkClass}>
          {link.label}
        </a>
      </>
    ))
  }
</nav>
