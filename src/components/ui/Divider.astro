---
import { cn } from '@/lib/cn';

type Variant = 'ember' | 'sand' | 'subtle';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'ember', class: className = '' } = Astro.props;

const variants: Record<Variant, string> = {
  ember: 'border-ember',
  sand: 'border-sand',
  subtle: 'border-baobab/30',
};
---

<hr class={cn('border-0 border-t', variants[variant], className)} />
