---
import { cn } from '@/lib/cn';

interface Props {
  text: string;
  class?: string;
  inverted?: boolean;
}

const { text, class: className = '', inverted = false } = Astro.props;
---

<p
  class={cn(
    'font-normal text-sm',
    inverted ? 'text-sand' : 'text-baobab',
    className,
  )}
>
  {text}
</p>
