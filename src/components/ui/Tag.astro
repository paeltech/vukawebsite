---
import { cn } from '@/lib/cn';

type Variant = 'sector' | 'climate' | 'programme' | 'status' | 'vuka-dark';

interface Props {
  variant?: Variant;
  label: string;
  class?: string;
}

const { variant = 'sector', label, class: className = '' } = Astro.props;

const variants: Record<Variant, string> = {
  sector: 'bg-ember text-parchment',
  climate: 'bg-rift-green text-sand',
  programme: 'bg-surface-dark text-parchment',
  'vuka-dark': 'bg-surface-dark text-parchment',
  status: 'bg-sand text-baobab',
};
---

<span
  class={cn(
    'inline-flex items-center rounded-sm px-3 py-1 font-light text-[11px] uppercase tracking-category',
    variants[variant],
    className,
  )}
>
  {label}
</span>
