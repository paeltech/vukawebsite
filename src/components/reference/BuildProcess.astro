---
import { referenceCopy } from '@/data/copy/reference';
import Button from '@/components/ui/Button.astro';
const copy = referenceCopy.home.process;
---
<div class="reference-process">
  <div class="reference-editorial"><p class="reference-label">{copy.label}</p><h2 class="reference-h2">{copy.headline}</h2></div>
  <ol class="reference-process-grid">{copy.steps.map((step, index) => <li><span class="reference-label">{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol>
  <div class="reference-process-bottom"><p>{copy.body}</p><Button href="/work-with-us" variant="light" size="lg">{copy.cta}</Button></div>
</div>
