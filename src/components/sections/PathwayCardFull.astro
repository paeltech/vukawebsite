---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import Tag from '@/components/ui/Tag.astro';
import type { PathwayCopy } from '@/data/copy/pathways';

interface Props {
  pathway: PathwayCopy;
  compact?: boolean;
  icon?: IconName;
  variant?: 'default' | 'dark';
}

const { pathway, compact = false, icon = 'pathway-founder', variant = 'default' } = Astro.props;

const cardClass =
  variant === 'dark'
    ? 'vuka-card-dark vuka-card-dark-hover'
    : 'vuka-card vuka-card-hover';
const iconWellClass = variant === 'dark' ? 'icon-well-dark' : 'icon-well';
const bodyClass = variant === 'dark' ? 'text-sand' : 'text-vuka-black';
const ctaClass =
  variant === 'dark'
    ? 'text-sand group-hover:text-ember'
    : 'text-baobab group-hover:text-ember';
---

<a
  href={`/what-we-do/${pathway.slug}`}
  class:list={['vuka-reveal group flex h-full flex-col p-8 no-underline', cardClass]}
>
  <div class="mb-4 flex items-start justify-between gap-4">
    <Tag variant="programme" label={pathway.eyebrow} class="self-start" />
    <div class:list={[iconWellClass, 'group-hover:border-ember']}>
      <Icon name={icon} class="text-ember" size={20} />
    </div>
  </div>
  {
    !compact && (
      <h3
        class:list={[
          'mb-4 font-bold text-xl leading-snug whitespace-pre-line',
          variant === 'dark' ? 'text-parchment' : '',
        ]}
      >
        {pathway.headline}
      </h3>
    )
  }
  <p class:list={['mb-6 flex-1 text-lg leading-relaxed whitespace-pre-line', bodyClass]}>
    {pathway.subcopy}
  </p>
  <span class:list={['inline-flex items-center gap-2 self-start font-normal transition-colors', ctaClass]}>
    See how this works →
    <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
  </span>
</a>
