---
import Icon from '@/components/ui/Icon.astro';
interface Props {
  body: string;
  statement: string;
  statementAccent: string;
  cta: { label: string; href: string };
}
const { body, statement, statementAccent, cta } = Astro.props;
---
<div class="editorial-heading">
  <a href={cta.href} class="editorial-label">{cta.label} <span aria-hidden="true">↗</span></a>
  <div>
    <h2 class="max-w-4xl text-h2 leading-[1.03] tracking-tight">{statement} {statementAccent}</h2>
    <p class="mt-10 max-w-3xl text-xl leading-[1.5] md:text-2xl">{body}</p>
    <div class="mt-10 border-t border-sand pt-6">
      <a href={cta.href} class="editorial-link">{cta.label}<Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</div>
