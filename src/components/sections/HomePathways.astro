---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
interface Props {
  headlineAccent: string;
  headline: string;
  statement: string;
  statementAccent: string;
  intro: string;
  sectionCta?: { label: string; href: string };
  portfolioCta?: { label: string; href: string };
  cards: readonly { tag: string; title: string; body: string; cta: { label: string; href: string } }[];
}
const { headlineAccent, headline, statement, statementAccent, intro, sectionCta, portfolioCta, cards } = Astro.props;
---
<div class="editorial-heading">
  <h2 class="editorial-label">{headlineAccent} {headline}</h2>
  <div>
    <p class="text-h2 leading-[1.03] tracking-tight">{statement} {statementAccent}</p>
    <p class="mt-8 max-w-2xl text-xl leading-relaxed">{intro}</p>
    <ol class="pathway-grid mt-12">
      {cards.map((card, index) => (
        <li class="border-t border-baobab pt-5">
          <p class="mb-4 text-sm text-baobab"><span aria-hidden="true">{String(index + 1).padStart(2, '0')} / </span>{card.tag}</p>
          <h3 class="mb-4 text-[28px] leading-[1.2] tracking-tight">{card.title}</h3>
          <p class="mb-5">{card.body}</p>
          <a href={card.cta.href} class="editorial-link">{card.cta.label}<Icon name="arrow-right" size={16} /></a>
        </li>
      ))}
    </ol>
    {(sectionCta || portfolioCta) && <div class="mt-10 flex flex-wrap gap-4">
      {sectionCta && <Button href={sectionCta.href}>{sectionCta.label}</Button>}
      {portfolioCta && <Button href={portfolioCta.href} variant="secondary">{portfolioCta.label}</Button>}
    </div>}
  </div>
</div>
