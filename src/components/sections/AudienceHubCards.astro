---
import Icon from '@/components/ui/Icon.astro';
import Tag from '@/components/ui/Tag.astro';
import type { AudienceCard } from '@/data/copy/types';

interface Props {
  cards: readonly AudienceCard[];
}

const { cards } = Astro.props;
---

<div class="vuka-reveal flex flex-col gap-4">
  {
    cards.map((card) => (
      <article class="grid grid-cols-1 gap-4 border border-sand bg-parchment p-6 md:grid-cols-2 md:items-start md:gap-10 md:p-8">
        <div>
          <Tag label={card.title} variant="programme" class="mb-4" />
          <h2 class="font-bold text-xl leading-snug text-vuka-black md:text-2xl">{card.problemHeadline}</h2>
        </div>
        <div class="flex flex-col gap-vuka-lg">
          <p class="text-lg leading-relaxed text-vuka-black">{card.body}</p>
          <a
            href={card.cta.href}
            class="inline-flex w-fit items-center gap-2 font-normal text-baobab transition-colors hover:text-ember"
          >
            {card.cta.label}
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </article>
    ))
  }
</div>
