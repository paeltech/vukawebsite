---
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  eyebrow: string;
  headlineAccent: string;
  headline: string;
  body: string;
  highlights: readonly string[];
  cta: { label: string; href: string };
}

const { eyebrow, headlineAccent, headline, body, highlights, cta } = Astro.props;
---

<div class="vuka-reveal grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-end lg:gap-16">
  <div class="lg:col-span-6">
    <Eyebrow text={eyebrow} class="mb-vuka-xl" />
    <h2 class="text-h2 font-heavy leading-[0.95] tracking-tight text-vuka-black">
      <span class="text-accent">{headlineAccent}</span>
      <br />
      {headline}
    </h2>
  </div>

  <div class="flex flex-col gap-vuka-2xl lg:col-span-6">
    <p class="max-w-lg text-lg leading-relaxed text-vuka-black">{body}</p>
    <ul class="space-y-3">
      {
        highlights.map((item) => (
          <li class="flex gap-3 text-lg leading-relaxed text-vuka-black">
            <Icon name="proof" class="mt-1 shrink-0 text-ember" size={18} />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <Button href={cta.href} variant="primary" size="lg" class="w-fit">
      {cta.label}
      <Icon name="arrow-right" size={18} />
    </Button>
  </div>
</div>
