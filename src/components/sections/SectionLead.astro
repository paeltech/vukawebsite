---
import { cn } from '@/lib/cn';

interface Props {
  class?: string;
  inverted?: boolean;
}

const { class: className = '', inverted = false } = Astro.props;
---

<div
  class={cn(
    'vuka-reveal border-l-4 border-ember pl-8 md:pl-12',
    inverted ? 'text-parchment' : '',
    className,
  )}
>
  <slot />
</div>
