---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Tag from '@/components/ui/Tag.astro';
import { pathwayLabels } from '@/data/copy/portfolio';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const { title, summary, sector, sectorLabel, pathway, stage, logo, logoDark } = entry.data;
const logoSrc = logoDark ? logoDark : logo;
---

<header class="venture-hero vuka-reveal">
  <Eyebrow text="Case study" class="mb-vuka-2xl" />

  <div class="mb-vuka-2xl flex flex-col gap-vuka-2xl sm:flex-row sm:items-center sm:justify-between">
    <img
      src={logoSrc}
      alt={`${title} logo`}
      class="max-h-14 w-auto max-w-[200px] object-contain object-left md:max-h-16"
      width="200"
      height="64"
      loading="eager"
      decoding="async"
    />
    <div class="flex flex-wrap gap-2 sm:justify-end">
      <Tag variant="sector" label={sectorLabel ?? sector} />
      <Tag variant="programme" label={pathwayLabels[pathway] ?? pathway} />
      <Tag variant="status" label={stage} />
    </div>
  </div>

  <h1 class="article-title">{title}</h1>
  <p class="mt-vuka-xl max-w-2xl text-xl leading-relaxed text-baobab">{summary}</p>
</header>
