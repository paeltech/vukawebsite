---
import Icon from '@/components/ui/Icon.astro';
import { cn } from '@/lib/cn';

export interface HubLink {
  label: string;
  description?: string;
  href: string;
}

interface Props {
  links: readonly HubLink[];
  inverted?: boolean;
  class?: string;
}

const { links, inverted = false, class: className = '' } = Astro.props;

const borderClass = inverted ? 'border-baobab/30 divide-baobab/30' : 'border-sand divide-sand';
const labelClass = inverted ? 'text-parchment group-hover:text-ember' : 'text-vuka-black group-hover:text-ember';
const descClass = inverted ? 'text-sand' : 'text-baobab';
const iconClass = inverted ? 'text-sand group-hover:text-ember' : 'text-baobab group-hover:text-ember';
---

<ul class={cn('vuka-reveal divide-y', borderClass, 'border', className)}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class="group flex items-start justify-between gap-6 px-6 py-5 no-underline transition-colors md:px-8 md:py-6"
        >
          <span class="min-w-0">
            <span class={cn('block font-bold text-lg leading-snug transition-colors', labelClass)}>
              {link.label}
            </span>
            {link.description && (
              <span class={cn('mt-1 block text-base leading-relaxed', descClass)}>{link.description}</span>
            )}
          </span>
          <Icon name="arrow-right" class={cn('mt-1 shrink-0 transition-transform group-hover:translate-x-1', iconClass)} size={18} />
        </a>
      </li>
    ))
  }
</ul>
