---
import type { StepItem } from '@/data/copy/types';

interface Props {
  steps: StepItem[];
}

const { steps } = Astro.props;
---

<ol class="space-y-0">
  {
    steps.map((step, index) => (
      <li class="vuka-reveal group relative flex gap-6 border-l border-sand pb-10 pl-8 last:pb-0 md:gap-8 md:pl-10">
        <div class="absolute -left-4 top-0 flex h-8 w-8 items-center justify-center border border-ember bg-parchment font-bold text-sm text-ember transition-colors group-hover:bg-ember group-hover:text-parchment">
          {String(index + 1).padStart(2, '0')}
        </div>
        <div class="pt-1">
          <p class="mb-2 font-bold text-xl">{step.title}</p>
          <p class="text-lg leading-relaxed text-vuka-black whitespace-pre-line">{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>
