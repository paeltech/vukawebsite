---
import type { StepItem } from '@/data/copy/types';

interface Props {
  steps: StepItem[];
}

const { steps } = Astro.props;
---

<ol class="process-rows">
  {steps.map((step, index) => (
    <li class="grid grid-cols-[32px_minmax(0,1fr)] gap-6 border-t border-sand py-8 md:grid-cols-[32px_minmax(0,1fr)_minmax(0,1.2fr)] md:gap-10">
      <span class="text-sm text-baobab" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <h3 class="text-2xl leading-tight">{step.title}</h3>
      <p class="col-start-2 whitespace-pre-line md:col-start-auto">{step.body}</p>
    </li>
  ))}
</ol>
