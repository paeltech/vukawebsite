---
import type { IconName } from '@/lib/icons';
import { cn } from '@/lib/cn';
interface Props { label: string; icon: IconName; inverted?: boolean; class?: string; }
const { label, inverted = false, class: className = '' } = Astro.props;
---
<div class={cn('editorial-heading vuka-reveal', className)}>
  <h2 class:list={['editorial-label', inverted && 'text-sand']}>{label}</h2>
  <div class="min-w-0"><slot /></div>
</div>
