---
import Button from '@/components/ui/Button.astro';
import Mark from '@/components/ui/Mark.astro';
import Tag from '@/components/ui/Tag.astro';

interface Props {
  left: string;
  right: string;
  essayCta: { label: string; href: string };
  teamCta?: { label: string; href: string };
  tags: string[];
  sectionLabel: string;
}

const { left, right, essayCta, teamCta, tags, sectionLabel } = Astro.props;
---

<div class="vuka-reveal">
  <div class="mb-vuka-3xl flex items-end justify-between gap-8">
    <h2 class="font-heavy text-h2 leading-tight">{sectionLabel}</h2>
    <div class="hidden w-16 shrink-0 opacity-20 md:block" aria-hidden="true">
      <Mark variant="ember" decorative />
    </div>
  </div>
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
    <p class="text-lg leading-relaxed whitespace-pre-line">{left}</p>
    <div class="border-l-4 border-ember pl-8">
      <p class="text-lg font-bold leading-relaxed text-ember whitespace-pre-line">{right}</p>
      <Button href={essayCta.href} variant="primary" class="mt-6">
        {essayCta.label}
      </Button>
      {
        teamCta && (
          <Button href={teamCta.href} variant="primary" class="mt-3">
            {teamCta.label}
          </Button>
        )
      }
    </div>
  </div>
  <div class="mt-vuka-3xl flex flex-wrap gap-3">
    {tags.map((tag) => (
      <Tag variant="status" label={tag} />
    ))}
  </div>
</div>
