---
import Icon from '@/components/ui/Icon.astro';
import Tag from '@/components/ui/Tag.astro';
import { pathwayLabels } from '@/data/copy/portfolio';
import { portfolioSlug, portfolioTeaser } from '@/lib/portfolio';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const { title, summary, sector, sectorLabel, pathway, stage, logo } = entry.data;
const href = `/portfolio/${portfolioSlug(entry)}`;
const teaser = portfolioTeaser(summary);
---

<a
  href={href}
  class="vuka-reveal group grid grid-cols-1 items-start gap-6 border border-sand bg-parchment p-6 no-underline transition-colors hover:border-baobab/40 md:grid-cols-[minmax(0,7rem)_1fr_auto] md:items-center md:gap-10 md:p-8"
>
  <img
    src={logo}
    alt=""
    class="max-h-10 w-auto max-w-[7rem] object-contain object-left"
    width="112"
    height="40"
    loading="lazy"
    decoding="async"
  />

  <div class="min-w-0">
    <h2 class="font-bold text-xl leading-snug text-vuka-black md:text-2xl">{title}</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      <Tag variant="sector" label={sectorLabel ?? sector} />
      <Tag variant="programme" label={pathwayLabels[pathway] ?? pathway} />
      <Tag variant="status" label={stage} />
    </div>
    <p class="mt-3 text-lg leading-relaxed text-vuka-black">{teaser}</p>
  </div>

  <Icon
    name="arrow-right"
    class="shrink-0 text-baobab transition-transform group-hover:translate-x-1 group-hover:text-ember"
    size={20}
  />
</a>
