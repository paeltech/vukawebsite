---
import type { FaqItem } from '@/data/copy/types';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="vuka-reveal divide-y divide-sand/60 bg-transparent">
  {
    items.map((item, index) => (
      <details class="group py-6 transition-colors open:bg-parchment/80 md:py-8">
        <summary class="cursor-pointer list-none font-bold text-xl marker:content-none [&::-webkit-details-marker]:hidden">
          <span class="flex items-start justify-between gap-4">
            <span class="flex items-start gap-4">
              <span class="mt-0.5 font-light text-sm text-baobab">
                {String(index + 1).padStart(2, '0')}
              </span>
              {item.question}
            </span>
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sand/40 text-ember transition-all group-open:rotate-45 group-open:bg-ember group-open:text-parchment"
              aria-hidden="true"
            >
              +
            </span>
          </span>
        </summary>
        <p class="mt-4 max-w-[64ch] pl-10 text-lg leading-relaxed text-vuka-black ">
          {item.answer.replace(/\s*\n\s*/g, ' ')}
        </p>
      </details>
    ))
  }
</div>
