---
import Icon from '@/components/ui/Icon.astro';
interface Props {
  headlineAccent: string;
  headline: string;
  intro: string;
  sectionCta: { label: string; href: string };
  cards: readonly { tag: string; headline: string; body: string; cta: { label: string; href: string } }[];
}
const { headlineAccent, headline, intro, sectionCta, cards } = Astro.props;
---
<div class="audience-list">
  <div class="editorial-heading">
    <a href={sectionCta.href} class="editorial-label">{sectionCta.label} <span aria-hidden="true">↗</span></a>
    <div>
      <h2 class="text-h2 leading-[1.03] tracking-tight">{headlineAccent} {headline}</h2>
      <p class="mt-6 text-lg">{intro}</p>
    </div>
  </div>
  {cards.map((card, index) => (
    <article class="editorial-row">
      <span class="row-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <p class="row-title">{card.tag}</p>
      <div class="row-content">
        <h3 class="text-[22px] leading-[1.36]">{card.headline}</h3>
        <p>{card.body}</p>
        <a class="editorial-link" href={card.cta.href}>{card.cta.label}<Icon name="arrow-right" size={16} /></a>
      </div>
    </article>
  ))}
</div>
