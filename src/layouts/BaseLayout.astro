---
import '@/styles/global.css';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { siteConfig } from '@/config/site';
import { buildSeo, type SeoProps } from '@/lib/seo';

interface Props extends SeoProps {
  class?: string;
  hideChrome?: boolean;
}

const { title, description, canonical, ogType, noindex, class: className = '', hideChrome = false } = Astro.props;
const seo = buildSeo({ title, description, canonical, ogType, noindex });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    <slot name="head" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    {seo.canonical && <meta property="og:url" content={seo.canonical} />}
    <link rel="icon" type="image/svg+xml" href="/assets/mark-ember.svg" />
  </head>
  <body class={className}>
    {!hideChrome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {!hideChrome && <Footer />}
    <script>
      import '@/scripts/reveal';
    </script>
  </body>
</html>
