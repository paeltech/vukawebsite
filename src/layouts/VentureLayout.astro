---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import PageCTA from '@/components/sections/PageCTA.astro';
import VentureAside from '@/components/sections/VentureAside.astro';
import VentureHero from '@/components/sections/VentureHero.astro';
import { portfolioPage } from '@/data/copy/portfolio';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <Section class="!pb-vuka-4xl">
    <article class="venture-page vuka-reveal">
      <div class="venture-canvas venture-canvas--with-aside">
        <VentureHero entry={entry} />

        <div class="venture-body">
          <div class="venture-grid venture-grid--with-aside">
            <div class="prose-vuka venture-prose min-w-0">
              <slot />
            </div>
            <VentureAside entry={entry} />
          </div>
        </div>
      </div>
    </article>
  </Section>

  <Section>
    <PageCTA cta={portfolioPage.bottomCta} />
  </Section>
</BaseLayout>
